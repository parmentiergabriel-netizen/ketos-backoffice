// ⚠️ NE PAS DÉPLOYER CE FICHIER.
// Le backoffice partage le projet Firebase de l'app Ketos (ketos-staging / ketos-app).
// Les règles déployées sont celles du dépôt `ketos` (firestore.rules, section « Backoffice »),
// déployées par sa CI. Ce fichier n'en garde qu'une copie de la section backoffice pour les tests
// locaux (npm test) : toute modification doit être reportée à l'identique dans le dépôt `ketos`.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }
    // Membre de l'équipe : compte non anonyme ET document admins/{uid} présent.
    function isStaff() {
      return isSignedIn()
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function isOwner() { return isStaff() && request.auth.uid == resource.data.ownerId; }

    function validItem(d) {
      return d.keys().hasOnly(['title', 'ownerId', 'createdAt'])
        && d.title is string && d.title.size() > 0 && d.title.size() <= 200
        && d.ownerId is string;
    }

    match /{document=**} { allow read, write: if false; }

    // Liste de l'équipe : gérée uniquement depuis la console Firebase (Admin SDK).
    match /admins/{uid} {
      allow get: if isSignedIn() && request.auth.uid == uid;
      allow list, write: if false;
    }


    // Données privées : private/{space}/items/{itemId} (ex. private/demo/items/abc).
    match /private/{space}/items/{itemId} {
      allow read, delete: if isOwner();
      allow create: if isStaff()
        && request.resource.data.ownerId == request.auth.uid
        && validItem(request.resource.data)
        && request.resource.data.createdAt == request.time;
      allow update: if isOwner()
        && validItem(request.resource.data)
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    match /public/{document=**} {
      allow read: if true;
      allow create, update, delete: if false;
    }
  }
}
